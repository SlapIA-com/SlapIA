<IfModule mod_rewrite.c>
    Options +FollowSymLinks
    RewriteEngine On
    Redirect 301 /accompagnement /formation

    # Force https://www.slapia.com for all domains (.fr, .com, non-www)
    # Désactivé en développement (APP_ENV=dev)
    RewriteCond %{ENV:APP_ENV} !=dev
    RewriteCond %{HTTP_HOST} !^www\.slapia\.com$ [NC]
    RewriteCond %{HTTP_HOST} !^localhost$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$ [NC]
    RewriteRule ^(.*)$ https://www.slapia.com/$1 [R=301,L]

    # Prevent potential loops
    RewriteCond %{ENV:REDIRECT_STATUS} ^$

    # Site pages now live in pages/ (index, formations, blog, legal pages,
    # etc.) — public URLs are unchanged, only the physical files moved.
    RewriteRule ^$ pages/index.php [L]

    # Remove .php extension and check in pages/ directory
    # Specific Legal Pages Rewrites
    # NOTE: these three used to all point at pages/mentions-legales.php, which
    # doesn't exist — the legal pages live at the site root, one file per topic
    # (mentions-legales.php, confidentialite.php, cgv.php). Fixed to route each
    # pretty URL to its real page.
    RewriteRule ^mentions-legales$ pages/mentions-legales.php [L,QSA]
    RewriteRule ^politique-confidentialite$ pages/confidentialite.php [L,R=301]
    RewriteRule ^cgv$ pages/cgv.php [L,R=301]

    # Blog article pretty URLs: /blog/<slug> -> blog-article.php?slug=<slug>
    # Was missing entirely — blog.php links to /blog/<slug> for every article,
    # but nothing routed that URL anywhere, so every article link 404'd.
    RewriteRule ^blog/([a-z0-9-]+)$ pages/blog-article.php?slug=$1 [L,QSA]

    # Direct "/name.php" requests (nav links, footer links) — served
    # transparently from pages/ now that the site templates live there.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/pages/$1 -f
    RewriteRule ^([A-Za-z0-9_-]+\.php)$ pages/$1 [L,QSA]

    # ROI Calculator
    # TODO: pages/Calcule-ROI-IA.php does not exist yet in this repo — this route
    # currently 404s. Left in place since it looks like planned/in-progress work,
    # not a bug to silently remove; build the page or drop the rule.
    RewriteRule ^Calcule-ROI-IA$ pages/Calcule-ROI-IA.php [L,QSA]

    # SlapIA Tool — permanent download link, always resolves to the latest GitHub release asset.
    # Routed internally to api/download-latest.php, which streams the .exe bytes through this
    # server instead of issuing an HTTP redirect: the Microsoft Store's package URL field (and
    # winget/App Installer) explicitly require a direct, non-redirecting download URL.
    # TODO: api/download-latest.php does not exist yet in this repo — this route
    # currently 404s. Left in place since the comment above describes deliberate,
    # specific intent, not a bug to silently remove; build the endpoint or drop the rule.
    RewriteRule ^downloads/latest/SlapIA-Tool-Setup\.exe$ api/download-latest.php [L,NE]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/pages/$1.php -f
    RewriteRule ^([^/]+)$ pages/$1.php [L,QSA]

    # Fallback for root files (like index.php handling if needed, though index is usually default)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^\.]+)$ $1.php [NC,L]

    # Custom Error Pages
    ErrorDocument 404 /404.php

    # Dynamic Sitemap
    RewriteRule ^sitemap\.xml$ pages/sitemap.php [L]

    # RSS Feed
    # TODO: rss.php does not exist yet in this repo — this route currently 404s,
    # and nothing on the site links to /rss.xml today. Left in place in case a
    # public RSS feed of the blog is planned; build it or drop the rule.
    RewriteRule ^rss\.xml$ rss.php [L]

    # SECURITY: Prevent access to sensitive files
    <FilesMatch "^\.env|composer\.(json|lock)|config\.php|inspect_db\.php|debug-notion\.php|\.git|README\.md">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS uniquement en production (évite de bloquer le navigateur en https sur le dev local)
    SetEnvIf APP_ENV "prod" IS_PROD
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=IS_PROD
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Content Security Policy — covers all external sources used by the project
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://challenges.cloudflare.com https://*.n8n.cloud; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://fonts.googleapis.com; font-src 'self' https://cdnjs.cloudflare.com https://unpkg.com https://fonts.gstatic.com; img-src 'self' data: https: blob:; frame-src 'self' https://challenges.cloudflare.com; connect-src 'self' https://api.notion.com https://*.n8n.cloud wss://*.n8n.cloud https://cdn.jsdelivr.net https://unpkg.com https://synologynasthomas.synology.me:5443; object-src 'none'; base-uri 'self';"
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresDefault "access plus 2 days"
</IfModule>