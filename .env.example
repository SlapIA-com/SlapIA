APP_NAME=SlapIA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# IPs/CIDR des reverse proxies devant l'app (Cloudflare + Caddy en prod).
# Laisser vide en dev (accès direct LAN sans proxy).
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base reprise de l'ancien site — hébergée sur le NAS (voir CLAUDE.md).
DB_CONNECTION=mysql
DB_HOST=192.168.1.253
DB_PORT=3306
DB_DATABASE=slapia
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=

QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@slapia.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare Turnstile (formulaires contact + mot de passe oublié)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Notion (back-office hérité, en cours de remplacement — voir CLAUDE.md)
NOTION_API_KEY=

# n8n — webhooks appelés côté serveur uniquement (jamais depuis le navigateur)
N8N_AUTH_WEBHOOK_URL=
N8N_CHAT_WEBHOOK=
N8N_ARTICLES_API_KEY=
N8N_CONTACT_WEBHOOK_URL=
N8N_AVIS_WEBHOOK_URL=
# IP locale du NAS pour contourner le NAT hairpin (ex. 192.168.1.253).
# Laisser vide si non concerné (voir App\Services\N8nWebhook).
N8N_INTERNAL_IP=
