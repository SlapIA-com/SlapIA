APP_NAME=SlapIA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base de données existante "slapia" (comptes/clients/prestations/factures/
# avis_clients/contact_siteweb/rss_subscriber) — mêmes identifiants que
# l'ancien includes/db.php.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=slapia
DB_USERNAME=
DB_PASSWORD=

# file/sync (pas database) : évite d'avoir à faire tourner les migrations
# internes Laravel (sessions/cache/jobs) sur la base de prod existante, et
# reste cohérent avec le choix "mono-serveur" déjà acté pour l'ancien site
# (voir docs/superpowers/specs/2026-07-28-auth-comptes-design.md).
SESSION_DRIVER=file
SESSION_LIFETIME=1440
CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

# Blog (Notion, lecture seule — base "RSS SlapIA" alimentée par n8n toutes
# les 48h, ID en dur dans NotionBlogService, ne pas déplacer en config).
NOTION_API_KEY=

# Formulaire de contact.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Emails transactionnels (reset password) — même webhook n8n que l'ancien site.
N8N_AUTH_WEBHOOK_URL=
